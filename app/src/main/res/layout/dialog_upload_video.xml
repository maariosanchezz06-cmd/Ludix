<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NUEVO CLIP"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etDialogInput"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Escribe un título..."
        android:paddingStart="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvDialogTitle"/>

    <Spinner
        android:id="@+id/spinnerJuegos"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:popupBackground="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/etDialogInput"/>

    <Button
        android:id="@+id/btnDialogSubmit"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_gradient"
        android:text="SUBIR VÍDEO"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/spinnerJuegos"/>
</androidx.constraintlayout.widget.ConstraintLayout>