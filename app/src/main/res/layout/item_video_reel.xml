<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="zoom"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llVideoInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginEnd="60dp" 
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvAutorClip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@usuario"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/tvJuegoClip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 Nombre del Juego"
            android:textColor="#00E5FF" 
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/tvTituloClip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aquí va el título que pone el usuario..."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPerfilMini"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginBottom="30dp"
            android:padding="1dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp"
            app:shapeAppearanceOverlay="@style/CircleShape"
            android:src="@drawable/logo_ludix"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivLike"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_heart_outline"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
            
        <TextView
            android:id="@+id/tvLikesCount" 
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0" 
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginBottom="25dp"
            android:shadowColor="@color/black"
            android:shadowRadius="3" />

        <ImageView
            android:id="@+id/ivComments"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_comments_outline"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView
            android:id="@+id/tvCommentsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginBottom="25dp"
            android:shadowColor="@color/black"
            android:shadowRadius="3" />

        <ImageView
            android:id="@+id/ivShare"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_share_outline"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:shadowColor="@color/black"
            android:shadowRadius="3" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>